# Legacy admin token for /update, /rollback, /admin/* (must match on server and client)
FONT_RENDER_TOKEN=change-me-to-something-random

# Per-client Bearer token for /render and /info (issued by: uv run font-render-clients add <id>)
# FONT_RENDER_CLIENT_TOKEN=
# Admin Bearer token (client with the admin scope), used by font-render-clients and by
# font-render --update/--rollback/--install-browser (takes precedence over FONT_RENDER_TOKEN)
# FONT_RENDER_ADMIN_TOKEN=

# Server URL (for the font-render* tools)
# FONT_RENDER_SERVER=http://100.100.100.100:8000

