# Settings of the font-render* tools in a checkout (users of the client package run
# `font-render login` instead). Copy to .env; values here are examples only.

# Server URL
# FONT_RENDER_SERVER=http://studio-pc:8000

# Render token of your client (issued by an admin: font-render-clients add <id>)
# FONT_RENDER_CLIENT_TOKEN=

# Admin token (client with the admin scope): font-render-clients, --update, --rollback,
# --install-browser
# FONT_RENDER_ADMIN_TOKEN=

# Developer-mode token (a client named in `font-render-server dev-mode on --client ...`):
# --deploy, --release
# FONT_RENDER_DEV_TOKEN=

# Legacy admin form token of old checkout servers. Leave it unset: with it set and
# legacy_admin_token on, anyone who knows it is an admin. Use reset-admin instead.
# FONT_RENDER_TOKEN=
